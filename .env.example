# DeepAgents AI Platform - Environment Variables

# LLM API Keys (required for agent functionality)
# ZhipuAI API Key - Get your free API key at: https://open.bigmodel.cn/api/key
ZHIPU_API_KEY=your_api_key_here

# Optional: Additional LLM API Keys
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Platform Configuration
API_TIMEOUT=10
CACHE_EXPIRY=300  # 5 minutes cache for agent responses